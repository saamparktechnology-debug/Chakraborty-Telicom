# ============================================================================
# AMUL PARTY DISTRIBUTION & SUBSCRIPTION PLATFORM — ENVIRONMENT CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# Database (MySQL 8.0+ InnoDB — separate runtime & migration credentials)
DATABASE_URL="mysql://root:root@localhost:3307/amul_distribution?connection_limit=20&pool_timeout=10&connect_timeout=10"
DIRECT_MIGRATION_DATABASE_URL="mysql://amul_migrator:CHANGE_ME_MIGRATOR_PASSWORD@localhost:3307/amul_distribution"

# Authentication & Security Secrets (Generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET="CHANGE_ME_64_BYTE_HEX_ACCESS_SECRET_DO_NOT_HARDCODE_IN_PROD"
JWT_REFRESH_SECRET="CHANGE_ME_64_BYTE_HEX_REFRESH_SECRET_DO_NOT_HARDCODE_IN_PROD"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CSRF_SECRET="CHANGE_ME_64_BYTE_HEX_CSRF_SECRET"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# Password Hashing (Argon2id parameters per OWASP guidelines)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://admin.amulparty.example.com"

# Configurable Business Rules (Section 20.4 Open Points)
SKIP_DAY_CUTOFF_HOUR_IST=21
SKIP_DAY_CUTOFF_MINUTE_IST=0
NEGATIVE_WALLET_POLICY="BLOCK" # Options: "BLOCK" | "ALLOW"
LOW_WALLET_THRESHOLD_INR="150.00"
INVOICE_NUMBER_PREFIX="INV-2026-"
CUSTOMER_BILL_PREFIX="BILL-2026-"
DEMO_ROLE_SWITCHER_ENABLED="false"

# Rate Limiting & Reliability
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120
